# NodeMarket configuration - copy to .env and edit.

# Long random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Sessions and signed cart cookies are bound to it.
SECRET_KEY=change-me-to-a-long-random-string

# Admin panel password.
ADMIN_PASSWORD=changeme-admin

# Storefront name shown in header/footer.
STORE_NAME=NodeMarket Store

# Currency code for display only (USD, EUR, BRL...).
CURRENCY=USD

# SQLite path (relative to project root).
DB_PATH=data/nodemarket.db

# Bind address. Keep 127.0.0.1 locally; behind a reverse proxy, set 0.0.0.0
# and leave logging to the proxy (NodeMarket itself never logs IPs).
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------------
# v0.3 - Payment methods & settlement (also configurable in /admin/settings)
# ---------------------------------------------------------------------------

# Bitcoin (BTC) — enable the method in /admin/settings.
#   xpub mode (non-custodial): paste an account-level extended public key in
#     the admin panel; a fresh P2WPKH address is derived per order via BIP32.
#     The server NEVER holds private keys. Pair with "Direct-to-Seller".
#   rpc mode (custodial): the local Bitcoin Core node wallet hands out a new
#     address per order. Keys live on the node. Pair with "Temporary Escrow".
# Credentials below are read from .env only — never stored in the database.
#BTC_RPC_URL=http://127.0.0.1:8332
#BTC_RPC_USER=your-rpc-user
#BTC_RPC_PASSWORD=your-rpc-password

# Monero (XMR) — enable the method in /admin/settings.
#   Direct (non-custodial): paste your main address and/or a comma-separated
#     list of subaddresses in the admin panel; each order rotates through
#     them. The server never holds private keys.
#   RPC (custodial): monero-wallet-rpc creates a dedicated subaddress per
#     order. Keys live on the server. Pair with "Temporary Escrow".
#XMR_WALLET_RPC_URL=http://127.0.0.1:18082/json_rpc
#XMR_WALLET_RPC_USER=your-rpc-user
#XMR_WALLET_RPC_PASSWORD=your-rpc-password

# Demo mode — enable in /admin/settings for local testing (no real payment).
